{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173",
    "https://portfolio-online-sepia.vercel.app"
  ],
  "RateLimit": {
    "PermitLimit": 60,
    "WindowMinutes": 1
  },
  "Cache": {
    "PortfolioTtlHours": 1
  },
  "Market": {
    "DefaultCryptos": [ "bitcoin", "ethereum", "solana" ],
    "DefaultStocks": [ "AAPL", "MSFT", "GOOGL" ],
    "RefreshMinutes": 20
  }
}
